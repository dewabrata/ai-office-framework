# ===== Autentikasi =====
# Pakai LANGGANAN Claude (Pro/Max): biarkan ANTHROPIC_API_KEY kosong,
# cukup sudah login lewat `claude` CLI. Pemakaian dipotong dari kuota langganan.
# Pakai API key (pay-as-you-go): isi ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# ===== Penyedia AI kustom (host pihak ketiga) =====
# AI_PROVIDER: claude (langganan/API key Anthropic) | openrouter | custom
#
# SYARAT host kustom: harus melayani skema ANTHROPIC (/v1/messages). Agent di sini
# berjalan di atas Claude Code, yang tidak bisa berbicara skema OpenAI
# (/v1/chat/completions). Host yang hanya OpenAI tidak bisa dipakai lewat jalur ini.
# Uji cepat: curl <host>/v1/messages dengan header x-api-key harus membalas 200.
#
# PERHATIAN kalau modelnya bukan Claude:
# - Claude Code tidak mengenal nama modelnya, jadi perhitungan biaya tidak dapat
#   dipercaya dan plafon BUDGET_* bisa tidak pernah terpicu.
# - Seluruh dokumen dan kode proyek dikirim ke host tersebut.
AI_PROVIDER=claude
CUSTOM_BASE_URL=https://host-anda.example/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=
# Opsional - petakan alias per tingkat ke model berbeda di host yang sama:
#CUSTOM_MODEL_OPUS=
#CUSTOM_MODEL_SONNET=
#CUSTOM_MODEL_HAIKU=

# ===== Jalur cadangan: OpenRouter (Anthropic-compatible endpoint) =====
# Aktifkan dengan USE_OPENROUTER=1. Hanya model Anthropic yang didukung lewat jalur ini.
USE_OPENROUTER=0
OPENROUTER_API_KEY=sk-or-...
# Kalau alias opus/sonnet/haiku tidak dikenali OpenRouter, cek dokumentasi OpenRouter
# soal variabel ANTHROPIC_DEFAULT_*_MODEL untuk memetakan alias ke model ID.

# ===== Model per peran =====
# Kosongkan atau hapus barisnya untuk memakai bawaan. Nilai: haiku | sonnet | opus.
# Per 12 Sep 2026, Claude Code v2.1.263 menerjemahkan alias itu menjadi:
#   opus   -> claude-opus-5              ($5 / $25 per 1 juta token in/out)
#   sonnet -> claude-sonnet-5            ($2 / $10)
#   haiku  -> claude-haiku-4-5-20251001  ($1 / $5)
# Alias opus dan sonnet TIDAK terikat tanggal, jadi bisa berpindah sendiri saat
# Claude Code diperbarui. Kalau ingin terkunci, isi id model lengkapnya di sini
# (mis. MODEL_SA=claude-opus-5). Model yang benar-benar dipakai dicatat tiap tahap
# di events.jsonl dan tampil di log dashboard.
# Bawaan: peran dokumen pakai opus (butuh penalaran, keluaran kecil), peran yang
# menulis/menguji kode pakai sonnet (volume token besar, tugas terstruktur).
# Kalau hasil sebuah peran sering mengecewakan, naikkan di sini - tidak perlu ubah kode.
#MODEL_BA=opus
#MODEL_BRD=opus
#MODEL_FSD=opus
#MODEL_SA=opus
#MODEL_DESIGNER=opus
#MODEL_LEAD=sonnet
#MODEL_QA_STAGE=sonnet
#MODEL_TECHWRITER=sonnet
#MODEL_PROGRAMMER=sonnet
#MODEL_QA=sonnet
#MODEL_PENTEST=sonnet
# Saat sebuah tahap GAGAL, gate menawarkan mengulang dengan model satu tingkat
# lebih tinggi (haiku -> sonnet -> opus). Kenaikan berlaku untuk tahap itu saja.

# ===== Batas biaya per tahap (USD) =====
BUDGET_BA=1.0
BUDGET_DOC=2.0
BUDGET_SA=1.5
BUDGET_DEV=8.0
BUDGET_QA=3.0
# Hanya dipakai office_bmad.py. office.py bertanya tiap ronde, tanpa batas angka.
MAX_FIX_LOOP=2
# Kalau kuota langganan habis:
#   QUOTA_WAIT=auto  -> tidur sampai waktu reset yang dikirim server, lalu ulang tahap otomatis
#   QUOTA_WAIT=ask   -> selalu tanya dulu di terminal
# Kalau waktu tunggu lebih dari QUOTA_WAIT_MAX_HOURS (mis. kuota mingguan), tetap tanya dulu.
QUOTA_WAIT=auto
QUOTA_WAIT_MAX_HOURS=6

# ===== Monitoring =====
# Telegram (opsional): notifikasi tahap/gate/kuota + jawab gate dari HP.
# Buat bot via @BotFather, ambil chat_id dari @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ===== Dashboard =====
# Bawaan 127.0.0.1: hanya bisa dibuka dari mesin ini. Ini disengaja - dashboard
# bisa menjalankan pipeline, dan agent di dalamnya punya akses Bash.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Wajib diisi kalau DASHBOARD_HOST bukan 127.0.0.1; tanpa itu dashboard menolak jalan.
DASHBOARD_USER=admin
DASHBOARD_PASS=
# Cara paling aman mengakses dari jauh - tidak membuka port sama sekali:
#   ssh -L 8765:127.0.0.1:8765 user@server
# Kalau memang harus dibuka, taruh di belakang reverse proxy ber-TLS: Basic auth
# lewat HTTP polos mengirim sandi tanpa enkripsi.
